---
import DefaultLayout from '../layouts/DefaultLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const PRIMARY_AGE = '14s';

const ages: string[] = ['10s', '11s', '12s', '13s', '14s', '15s', '16s', '17s', '18s'];

const skills: Array<{ slug: string; label: string }> = [
  { slug: 'passing', label: 'Passing' },
  { slug: 'setting', label: 'Setting' },
  { slug: 'hitting', label: 'Hitting' },
  { slug: 'blocking', label: 'Blocking' },
  { slug: 'serving', label: 'Serving' },
  { slug: 'defense', label: 'Defense' },
  { slug: 'transition', label: 'Transition' },
];

const taskTiles: Array<{ kicker: string; title: string; desc: string; href: string }> = [
  {
    kicker: 'In the gym',
    title: 'Courtside',
    desc: 'The gym screen: your age group’s guide, cues, drill picks, and tryout rubric, one tap each.',
    href: `${base}/courtside/`,
  },
  {
    kicker: 'Standards',
    title: '14s age guide',
    desc: 'Milestones, systems, and promotion criteria for the current team. Adjacent ages are one click away.',
    href: `${base}/manual/ages/${PRIMARY_AGE}/`,
  },
  {
    kicker: 'Lookup',
    title: 'Find a cue or technique',
    desc: 'Cue dictionaries by skill, technique pages with schools-perspectives, position guides.',
    href: `${base}/manual/cues/`,
  },
  {
    kicker: 'Tryout',
    title: 'Run a tryout',
    desc: '14U evaluation rubric · 8 rows × 5 columns of observable criteria · session structure.',
    href: `${base}/ops/tryout-rubric-14u/`,
  },
  {
    kicker: 'Decide',
    title: 'Compare schools of thought',
    desc: 'Where the Italian, Brazilian, Russian, USA, and GMS traditions disagree on setting, hitting, defense, and out-of-system play.',
    href: `${base}/techniques/setting-distribution/`,
  },
  {
    kicker: 'Search',
    title: 'Search the bible',
    desc: 'Full-text search across 1100+ pages and 787 cited sources.',
    href: `${base}/search/`,
  },
];

const methodHubs: Array<{ slug: string; label: string; desc: string }> = [
  { slug: 'practice-planning', label: 'Practice planning', desc: 'Periodization, session design, microcycle planning, practice ratios.' },
  { slug: 'season-planning', label: 'Season planning', desc: 'Preseason / in-season / pre-tournament / taper arc; tournament prep.' },
  { slug: 'mental', label: 'Mental skills', desc: 'Culture, leadership, pressure, motivation, self-talk, IZOF, choking.' },
  { slug: 'physical', label: 'Physical preparation', desc: 'S&C, jump training, mobility, ACL prevention, RED-S, arm care.' },
  { slug: 'match-prep', label: 'Match prep', desc: 'Scouting, stats, video analysis, in-match adjustments, halftime framework.' },
  { slug: 'recruiting', label: 'Recruiting', desc: 'NCAA calendar, college pathway, film prep, list management.' },
];
---
<DefaultLayout title="Volleyball Coaching Bible" description="A sourced coaching manual for girls indoor volleyball, 10s through 18s: age guides, cues, drills, and tryout rubrics, every claim cited.">

  <!-- Hero band: dusk court treatment; drops in a real photo when
       webapp/public/hero-photo.jpg exists (cleared for publication). -->
  <section class="hero-band no-print" style={`--hero-photo:url('${base}/hero-photo.jpg'); --coach-photo:url('${base}/coach-photo.jpg')`}>
    <svg class="hero-court" viewBox="0 0 1200 480" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <g stroke="#dbeafe" stroke-width="2" fill="none">
        <rect x="150" y="70" width="900" height="360" rx="2"/>
        <line x1="600" y1="70" x2="600" y2="430"/>
        <line x1="450" y1="70" x2="450" y2="430" stroke-dasharray="6 10" opacity=".6"/>
        <line x1="750" y1="70" x2="750" y2="430" stroke-dasharray="6 10" opacity=".6"/>
      </g>
    </svg>
    <div class="hero-inner max-w-6xl mx-auto px-4">
      <span class="hero-eyebrow">NorCal · girls indoor 6s · 10s through 18s</span>
      <h1>A sourced coaching manual for girls indoor volleyball</h1>
      <p class="hero-sub">
        Age-by-age skill standards, canonical cues, tryout rubrics, and 100+ drills, with every claim traced to the coach or study it came from.
      </p>
      <div class="hero-ctas">
        <a class="hero-pill hero-pill-solid" href={`${base}/courtside/`}>Open Courtside</a>
        <a class="hero-pill hero-pill-ghost" href={`${base}/manual/`}>Browse the manual</a>
      </div>
      <div class="hero-trust">
        <div><b>787</b><i>Cited sources</i></div>
        <div><b>102</b><i>Drills</i></div>
        <div><b>9</b><i>Age guides</i></div>
        <div><b>73</b><i>Coach profiles</i></div>
      </div>
      <a class="hero-note" href="#coach-note">
        <span class="hero-note-avatar" aria-hidden="true">CS</span>
        <span>
          <span class="hero-note-eyebrow">A note from the coach</span>
          "I started this as my own coaching notebook. It's public because I wanted to give back to the community that's been so generous with me."
          <span class="hero-note-more">Read the full note ↓</span>
        </span>
      </a>
    </div>
  </section>

  <!-- Preamble: a note from the coach -->
  <section id="coach-note" class="max-w-5xl mx-auto px-4 pb-10 pt-10">
    <aside class="preamble">
      <div class="kicker mb-3">A note from the coach</div>
      <p>
        I started this as my own coaching notebook. It's public now because I wanted to give back to the community that's been so generous with me.
      </p>
      <p>
        The single biggest influence has been <strong>Mike Lingenfelter at Munciana</strong>. Mike's approach is the model: generous coaching, done in the open, with the kids at the center.
      </p>
      <p>
        Closer to home, my fellow coaches across <strong>NorCal</strong> have backed me through every year of my growth as a coach. Sideline conversations and tournament hallways are the best coaching education I've had.
      </p>
      <p>
        Plenty of others shaped this work too: USA national team voices through USAV and Gold Medal Squared, the Italian and Brazilian schools, Japanese coaching traditions, and club coaches all over the world who put their best thinking online for the rest of us to find.
      </p>
      <p>
        If any of this helps you become a better coach and mentor for the kids in your gym, the whole thing was worth doing.
      </p>
      <p class="preamble-sig">Coach Song</p>
    </aside>
  </section>

  <!-- Task tiles: I want to… -->
  <section class="max-w-6xl mx-auto px-4 pb-10">
    <h2 class="kicker mb-3">I want to…</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {taskTiles.map((t) => (
        <a href={t.href} class="task-tile block p-5 rounded-lg border border-slate-200 bg-white hover:border-blue-400 hover:bg-blue-50/40 no-underline transition-colors">
          <div class="kicker mb-2">{t.kicker}</div>
          <h3 class="tracking-tight text-lg font-semibold text-slate-900 mb-1 leading-tight">{t.title}</h3>
          <p class="text-sm text-slate-600 leading-snug">{t.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- By age -->
  <section class="max-w-6xl mx-auto px-4 pb-8">
    <div class="flex items-baseline justify-between mb-3">
      <h2 class="kicker">By age</h2>
      <a href={`${base}/manual/`} class="text-xs text-slate-500 hover:text-blue-700 no-underline">All ages →</a>
    </div>
    <div class="age-strip">
      {ages.map((a) => (
        <a
          href={`${base}/manual/ages/${a}/`}
          class:list={[
            'age-pill',
            a === PRIMARY_AGE ? 'age-pill-primary' : '',
          ]}
        >
          {a}
          {a === PRIMARY_AGE && <span class="age-pill-badge">primary</span>}
        </a>
      ))}
    </div>
  </section>

  <!-- By skill -->
  <section class="max-w-6xl mx-auto px-4 pb-10">
    <div class="flex items-baseline justify-between mb-3">
      <h2 class="kicker">By skill</h2>
      <a href={`${base}/library/`} class="text-xs text-slate-500 hover:text-blue-700 no-underline">All techniques →</a>
    </div>
    <div class="skill-strip">
      {skills.map((s) => (
        <a href={`${base}/${s.slug}/`} class="skill-pill">{s.label}</a>
      ))}
    </div>
  </section>

  <!-- Methodology + planning hubs -->
  <section class="max-w-6xl mx-auto px-4 pb-12">
    <h2 class="kicker mb-3">Methodology &amp; planning</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {methodHubs.map((m) => (
        <a href={`${base}/${m.slug}/`} class="method-tile block p-4 rounded-md border border-slate-200 bg-slate-50 hover:bg-white hover:border-slate-300 no-underline transition-colors">
          <h3 class="tracking-tight text-base font-semibold text-slate-900 mb-1">{m.label}</h3>
          <p class="text-sm text-slate-600 leading-snug">{m.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Sources & credibility footer -->
  <section class="max-w-5xl mx-auto px-4 pb-16">
    <div class="border-t border-slate-200 pt-6">
      <h2 class="kicker mb-3">Sources &amp; method</h2>
      <p class="text-sm text-slate-600 leading-relaxed">
        787 cited sources, presented neutrally across schools of thought. Coverage spans Karch Kiraly's <em>Championship Volleyball</em>, Hugh McCutcheon's <em>Championship Behaviors</em>, Mike Lingenfelter's Munciana camp library, the Art of Coaching Volleyball and Gold Medal Squared corpora, peer-reviewed sports-science research, and the major coaching books.
      </p>
      <p class="text-sm text-slate-600 leading-relaxed mt-3">
        Every claim resolves to a source page. Contested topics carry <strong>schools-perspectives</strong> sections that present rival positions side by side without resolving them. Neutrality is a hard rule.
      </p>
    </div>
  </section>

</DefaultLayout>

<style>
  /* Hero band: slate dusk gradient + court lines; the --hero-photo layer
     paints only when webapp/public/hero-photo.jpg exists. */
  .hero-band {
    position: relative;
    overflow: hidden;
    color: #fff;
    background-image:
      radial-gradient(120% 90% at 78% 12%, rgba(59, 130, 246, 0.28), transparent 55%),
      radial-gradient(90% 70% at 15% 95%, rgba(147, 111, 60, 0.30), transparent 60%),
      linear-gradient(105deg, rgba(11, 21, 38, 0.92) 30%, rgba(11, 21, 38, 0.55) 62%, rgba(18, 35, 61, 0.45)),
      var(--hero-photo, none);
    background-color: #0b1526;
    background-size: auto, auto, auto, cover;
    background-position: center;
  }
  .hero-court { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0.22; pointer-events: none; }
  .hero-inner { position: relative; padding-top: 3.5rem; padding-bottom: 2.2rem; }
  .hero-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #93c5fd;
    margin-bottom: 0.9rem;
  }
  .hero-band h1 {
    font-size: clamp(2.1rem, 5.5vw, 3.4rem);
    line-height: 1.06;
    font-weight: 600;
    letter-spacing: -0.03em;
    margin: 0 0 0.9rem;
    max-width: 17ch;
    text-wrap: balance;
    color: #fff;
  }
  .hero-sub { max-width: 54ch; color: #cbd5e1; font-size: 1.05rem; line-height: 1.6; margin: 0 0 1.4rem; }
  .hero-ctas { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1.6rem; }
  .hero-pill {
    display: inline-flex; align-items: center; min-height: 44px;
    border-radius: 9999px; padding: 0.7rem 1.5rem;
    font-weight: 600; font-size: 0.95rem; text-decoration: none;
  }
  .hero-pill-solid { background: var(--color-accent); color: #fff; }
  .hero-pill-solid:hover { background: var(--color-accent-strong); color: #fff; }
  .hero-pill-ghost { background: rgba(255, 255, 255, 0.08); color: #fff; border: 1px solid rgba(255, 255, 255, 0.35); }
  .hero-pill-ghost:hover { background: rgba(255, 255, 255, 0.16); color: #fff; }
  .hero-trust {
    display: flex; gap: 1.8rem; flex-wrap: wrap;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    padding-top: 1rem;
  }
  .hero-trust b {
    display: block;
    font-family: var(--font-mono);
    font-size: 1.35rem; font-weight: 700; letter-spacing: -0.02em;
    color: #fff; font-variant-numeric: tabular-nums;
  }
  .hero-trust i {
    font-style: normal; font-size: 0.66rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.07em; color: #94a3b8;
  }
  .hero-note {
    position: absolute; right: 1rem; bottom: 5.4rem; width: 260px;
    display: none; gap: 0.6rem;
    background: rgba(255, 255, 255, 0.97); color: var(--color-ink);
    border-radius: 12px; padding: 0.85rem;
    font-size: 0.8rem; line-height: 1.5; text-decoration: none;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }
  @media (min-width: 1024px) { .hero-note { display: flex; } }
  .hero-note:hover { color: var(--color-ink); }
  .hero-note-avatar {
    flex: none; width: 36px; height: 36px; border-radius: 9999px;
    display: flex; align-items: center; justify-content: center;
    background: var(--color-accent-soft) var(--coach-photo, none) center 15% / cover;
    color: var(--color-accent-strong);
    font-family: var(--font-mono); font-weight: 700; font-size: 0.75rem;
  }
  .hero-note-eyebrow {
    display: block;
    font-family: var(--font-mono); font-size: 0.62rem; font-weight: 500;
    letter-spacing: 0.09em; text-transform: uppercase; color: var(--color-accent);
    margin-bottom: 0.25rem;
  }
  .hero-note-more { display: block; margin-top: 0.35rem; font-weight: 600; color: var(--color-accent); font-size: 0.72rem; }

  /* Preamble block — short personal note under the hero */
  .preamble {
    border-left: 4px solid var(--color-accent);
    background: linear-gradient(180deg, #fff 0%, var(--color-accent-soft) 240%);
    padding: 1.25rem 1.5rem 1.1rem;
    border-radius: 0 6px 6px 0;
    max-width: 68ch;
    font-family: var(--font-serif);
    font-size: 1.08rem;
    line-height: 1.65;
    color: var(--color-ink);
  }
  .preamble p {
    margin: 0.7em 0;
  }
  .preamble p:first-of-type {
    margin-top: 0;
  }
  .preamble strong {
    color: var(--color-accent);
  }
  .preamble-sig {
    margin-top: 1.1em !important;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--color-muted);
    font-style: italic;
  }

  /* Age strip */
  .age-strip {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
    scrollbar-width: thin;
  }
  .age-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--color-rule);
    border-radius: 9999px;
    background: white;
    color: var(--color-ink);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .age-pill:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    text-decoration: none;
  }
  .age-pill-primary {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: white;
  }
  .age-pill-primary:hover {
    background: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
    color: white;
  }
  .age-pill-badge {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: rgba(255, 255, 255, 0.25);
    padding: 0.1rem 0.4rem;
    border-radius: 9999px;
  }

  /* Skill strip */
  .skill-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .skill-pill {
    display: inline-block;
    padding: 0.45rem 1rem;
    border: 1px solid var(--color-rule);
    border-radius: 0.5rem;
    background: white;
    color: var(--color-ink);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
  }
  .skill-pill:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-accent-soft);
    text-decoration: none;
  }

  /* Override default underline for tile-style anchors */
  .task-tile, .method-tile, .age-pill, .skill-pill {
    text-decoration: none;
  }
  .task-tile:hover, .method-tile:hover {
    text-decoration: none;
  }
</style>
