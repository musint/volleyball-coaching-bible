---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
const isActive = (href: string) => href === `${base}/` ? path === href : path.startsWith(href);
const navItems = [
  { href: `${base}/`, label: 'Home' },
  { href: `${base}/manual/`, label: 'Manual' },
  { href: `${base}/courtside/`, label: 'Courtside' },
  { href: `${base}/drills/`, label: 'Drills' },
  { href: `${base}/library/`, label: 'Library' },
  { href: `${base}/coaches/`, label: 'Coaches' },
  { href: `${base}/schools/`, label: 'Schools' },
  { href: `${base}/search/`, label: 'Search' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#f7f8fa" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="Coaching Bible" />
  <title>{title} · Coaching Bible</title>
  {description && <meta name="description" content={description} />}
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <link rel="manifest" href={`${base}/manifest.webmanifest`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />
</head>
<body class="min-h-screen flex flex-col">
  <nav class="border-b border-slate-200 bg-slate-50/80 backdrop-blur sticky top-0 z-30 no-print">
    <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
      <a href={`${base}/`} class="tracking-tight text-lg font-semibold text-slate-900 no-underline">
        Coaching Bible
      </a>
      <div class="hidden md:flex items-center gap-5 text-sm">
        {navItems.slice(1).map(item => (
          <a href={item.href}
             aria-current={isActive(item.href) ? 'page' : undefined}
             class={`no-underline hover:text-blue-700 ${isActive(item.href) ? 'text-blue-700 font-semibold' : 'text-slate-700'}`}>{item.label}</a>
        ))}
      </div>
      <a href={`${base}/search/`} class="md:hidden text-slate-700 no-underline p-2 -mr-2" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5" aria-hidden="true">
          <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
        </svg>
      </a>
    </div>
  </nav>

  <main class="flex-1 pb-24 md:pb-0">
    <slot />
  </main>

  <footer class="border-t border-slate-200 mt-16 py-6 text-sm text-slate-500 no-print">
    <div class="max-w-6xl mx-auto px-4 flex flex-wrap justify-between gap-4">
      <span>Volleyball Coaching Bible · maintained by Coach Song</span>
      <a href="https://github.com/musint/volleyball-coaching-bible" class="text-slate-500 hover:text-blue-700">github</a>
    </div>
  </footer>

  <!-- mobile bottom tabs: Manual · Drills · [Courtside] · Cues · Search -->
  <nav class="tabbar md:hidden fixed bottom-0 inset-x-0 border-t border-slate-200 bg-white shadow-lg z-40 no-print" aria-label="Quick navigation">
    <div class="grid grid-cols-5 items-end text-[0.65rem] pt-1 pb-1">
      <a href={`${base}/manual/`} aria-current={isActive(`${base}/manual/`) ? 'true' : undefined} class="text-slate-700 no-underline">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z"/><path d="M4 19a2 2 0 0 1 2-2h13"/></svg>
        Manual
      </a>
      <a href={`${base}/drills/`} aria-current={isActive(`${base}/drills/`) ? 'true' : undefined} class="text-slate-700 no-underline">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V2h6v2M9 9h6M9 13h6M9 17h4"/></svg>
        Drills
      </a>
      <a href={`${base}/courtside/`} aria-current={isActive(`${base}/courtside/`) ? 'true' : undefined} class="tab-courtside no-underline" aria-label="Courtside quick reference">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 3c3 2.5 3 15 0 18M3.5 9h17M3.5 15h17"/></svg>
      </a>
      <a href={`${base}/manual/cues/`} aria-current={isActive(`${base}/manual/cues/`) ? 'true' : undefined} class="text-slate-700 no-underline">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5c-1.6 0-3.1-.4-4.4-1.2L3 20l1.2-5.1A8.5 8.5 0 1 1 21 11.5z"/></svg>
        Cues
      </a>
      <a href={`${base}/search/`} aria-current={isActive(`${base}/search/`) ? 'true' : undefined} class="text-slate-700 no-underline">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        Search
      </a>
    </div>
  </nav>

  <script is:inline define:vars={{ base }}>
    if ('serviceWorker' in navigator && location.hostname !== 'localhost') {
      navigator.serviceWorker.register(`${base}/sw.js`).catch(() => {});
    }
  </script>
</body>
</html>
